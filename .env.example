# ==========================================
# MediVision AI - Environment Configuration
# ==========================================

# Backend API Configuration
PROJECT_NAME="MediVision AI Research Platform"
API_V1_PREFIX="/api"
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# MongoDB Atlas Configuration (System automatically falls back to Local MongoDB if offline or unconfigured)
# Real Atlas format: mongodb+srv://<username>:<password>@cluster0.your-subdomain.mongodb.net/?retryWrites=true&w=majority
# IMPORTANT: Remove the '<' and '>' angle brackets when pasting your username and password.
# IMPORTANT: Whitelist your current IP address under Security -> Network Access in your MongoDB Atlas Dashboard.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your-subdomain.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=medivision_ai
MONGODB_CONNECT_TIMEOUT_MS=3000

# Frontend API Target (for frontend .env)
VITE_API_BASE_URL=http://localhost:8001
