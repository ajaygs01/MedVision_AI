PROJECT_NAME="MediVision AI Research Platform"
API_V1_PREFIX="/api"
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# MongoDB Atlas Configuration (System operates gracefully if unset)
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# Note: Remove the '<' and '>' angle brackets around username and password when pasting from Atlas.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your-subdomain.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=medivision_ai
MONGODB_CONNECT_TIMEOUT_MS=3000

# Brain MRI Model Configuration
# Explicit opt-in for experimental 10p/3e prototype evaluation (default: false)
BRAIN_MRI_EXPERIMENTAL_MODE=false
